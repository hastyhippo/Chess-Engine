+// Classic HalfKP: (own king square) x (piece square, piece type, piece color),
+// kings excluded, board rotated 180 degrees for black's perspective.
+// No BONA_PIECE_ZERO padding, so INPUTS = 64 * 640 = 40960.
+struct HalfKP {
+    static constexpr std::string_view NAME = "HalfKP";
+
+    static constexpr int NUM_SQ              = 64;
+    static constexpr int NUM_PT              = 10;  // 5 piece types x 2 colors
+    static constexpr int NUM_PLANES          = NUM_SQ * NUM_PT;
+    static constexpr int INPUTS              = NUM_PLANES * NUM_SQ;
+    static constexpr int MAX_ACTIVE_FEATURES = 30;
+
+    static Square orient(Color color, Square sq) {
+        if (color == Color::Black)
+            sq = sq.flippedVertically().flippedHorizontally();
+        return sq;
+    }
+
+    static int feature_index(Color color, Square ksq, Square sq, Piece p) {
+        auto p_idx = static_cast<int>(p.type()) * 2 + (p.color() != color);
+        return static_cast<int>(orient(color, sq)) + p_idx * NUM_SQ
+             + static_cast<int>(orient(color, ksq)) * NUM_PLANES;
+    }
+
+    static std::pair<int, int>
+    fill_features_sparse(const TrainingDataEntry& e, int* features, Color color) {
+        auto& pos    = e.pos;
+        auto  pieces = pos.piecesBB();
+        auto  ksq    = pos.kingSquare(color);
+
+        int j = 0;
+        for (Square sq : pieces)
+        {
+            auto p = pos.pieceAt(sq);
+            if (p.type() == PieceType::King)
+                continue;
+            features[j] = feature_index(color, ksq, sq, p);
+            ++j;
+        }
+        return {j, INPUTS};
+    }
+};
+
+struct HalfKPExtractor: IFeatureExtractor {
+    int inputs() const override { return HalfKP::INPUTS; }
+    int max_active_features() const override { return HalfKP::MAX_ACTIVE_FEATURES; }
+    std::pair<int, int> fill_features_sparse(const TrainingDataEntry& e,
+                                             int*                     features,
+                                             Color                    color) const override {
+        return HalfKP::fill_features_sparse(e, features, color);
+    }
+};
+
